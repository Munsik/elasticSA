{
  "name": "Elastic Vector Search Demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/vector_demo",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"    // 🔥 Jupyter 익스텐션 추가
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt"
}